{
  "name": "@dotrino/profile",
  "version": "0.21.1",
  "peerDependencies": {
    "@dotrino/identity": ">=0.33.0",
    "@dotrino/proxy-client": ">=0.44.0"
  },
  "description": "Web Component (custom element) <dotrino-profile> reutilizable por cualquier app del ecosistema Dotrino: tarjeta de perfil + reputación (confianza/afinidad, web-of-trust, reputación de la red), y los amigos: añadir, aceptar y escribir a todos sus aparatos (@dotrino/profile/friends y /friends-ui). Autohosteado, Shadow DOM, temable por CSS vars.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./friends": {
      "types": "./src/friends/index.d.ts",
      "import": "./src/friends/index.js"
    },
    "./friends-ui": {
      "types": "./src/friends/ui.d.ts",
      "import": "./src/friends/ui.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dotrino",
    "web-component",
    "custom-element",
    "profile",
    "reputation",
    "web-of-trust",
    "cross-app",
    "friends",
    "contacts"
  ],
  "author": "seyacat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-profile.git"
  },
  "devDependencies": {
    "@dotrino/proxy-client": "^0.44.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependenciesMeta": {
    "@dotrino/proxy-client": {
      "optional": true
    }
  },
  "dependencies": {
    "@dotrino/qr": "0.3.1"
  }
}
